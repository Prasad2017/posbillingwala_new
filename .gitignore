# P5-5: Never commit production dumps or local secrets

# Full database dumps (schema reference lives in API/schema/)
/*.sql
!spllmgkn_posbill_complete.sql
!API/migrations/*.sql
!API/schema/schema_reference.sql
!API/schema/posbill_install.sql

# Local DB credentials (copy from db_local.example.php)
API/db_local.php

# Environment files
.env
.env.*
!.env.example

# Web admin — never commit deps or local env
posbillingwala.com/adminpanel/.env
posbillingwala.com/adminpanel/.env.*
posbillingwala.com/adminpanel/vendor/
posbillingwala.com/adminpanel/node_modules/
posbillingwala.com/adminpanel/storage/logs/
posbillingwala.com/adminpanel/storage/framework/cache/
posbillingwala.com/adminpanel/storage/framework/sessions/
posbillingwala.com/adminpanel/storage/framework/views/

# Local deploy archives
posbillingwala.com.zip

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.iml

# Android build outputs (per-module gitignores may also apply)
**/build/
**/.gradle/
**/local.properties

# Secrets / keys
**/GoogleService-Info.plist
*.keystore
*.jks
!PosBillingwala.jks
API/license_signing_private.pem
# google-services.json is tracked for Firebase builds (Dealer/Owner/WithTable)

# Local release APK/AAB copies (build with ./build-release.sh)
releases/**/*.apk
releases/**/*.aab
releases/**/*.idsig
