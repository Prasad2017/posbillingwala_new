<?xml version="1.0" encoding="utf-8"?>
<!-- Allow cleartext HTTP to the API host on Wi‑Fi and mobile data. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">posbillingwala.com</domain>
    </domain-config>
</network-security-config>
