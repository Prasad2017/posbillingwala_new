<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_share_link_field" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppinsbold"
        android:text="@string/share_qr_dialog_title"
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppinsregular"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/share_qr_dialog_subtitle"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/colorBorder"
        app:strokeWidth="1dp">

        <ImageView
            android:id="@+id/qrCodeImage"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/share_qr_dialog_title"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_share_app_qr" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/closeQrDialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_share_primary_button"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:text="@string/share_qr_dialog_close"
        android:textColor="@color/white"
        android:textSize="14sp" />

</LinearLayout>
