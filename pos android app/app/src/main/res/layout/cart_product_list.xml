<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <!-- Aligns with header: Product Name | Quantity | Unit Price | delete -->
    <TextView
        android:id="@+id/productName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.4"
        android:ellipsize="end"
        android:fontFamily="@font/poppinsregular"
        android:gravity="start|center_vertical"
        android:hyphenationFrequency="none"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:paddingEnd="6dp"
        android:textColor="@color/colorTextPrimary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/productRemove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_cart_qty_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="−"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/productQuantity"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="24dp"
            android:textColor="@color/colorTextPrimary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/productAdd"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_cart_qty_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/productPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.75"
        android:fontFamily="@font/poppinsregular"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/colorTextPrimary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/productDelete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        android:padding="4dp"
        android:src="@drawable/ic_delete"
        app:tint="@color/statusExpired" />

    <!-- Kept for adapter compatibility; unused in this layout -->
    <ImageView
        android:id="@+id/productIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/productLineTotal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/rowDivider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
