<?xml version="1.0" encoding="utf-8"?>
<com.pos_billingwala.Extra.PosCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/HomeKpiCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/radius_md">

    <LinearLayout
        android:id="@+id/kpiContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_kpi_card_blue"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:id="@+id/kpiLabel"
            style="@style/PosKpiLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Label" />

        <TextView
            android:id="@+id/kpiValue"
            style="@style/PosKpiValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="0"
            android:textColor="@color/kpiBlue" />

        <TextView
            android:id="@+id/kpiTrend"
            style="@style/PosKpiTrend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+0%" />
    </LinearLayout>
</com.pos_billingwala.Extra.PosCardView>
