<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/splitInputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppinsmedium"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/splitInputHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppinsregular"
        android:textColor="@color/grey_60"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/splitInputField"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppinsregular"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="2"
        android:textColor="@color/black"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/splitInputConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/continue_items_table_button_view"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:text="Continue"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/splitInputCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppinsregular"
        android:gravity="center"
        android:text="@android:string/cancel"
        android:textColor="@color/grey_60"
        android:textSize="14sp" />
</LinearLayout>
