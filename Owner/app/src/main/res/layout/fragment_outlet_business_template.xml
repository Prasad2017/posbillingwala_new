<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    tools:context=".Fragment.OutletBusinessTemplate">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_pos_report_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppinsregular"
                android:text="@string/outlet_template_intro"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/outlet_template_outlet"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/outletSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_outline" />

            <TextView
                android:id="@+id/currentTemplateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppinsregular"
                android:text="@string/outlet_template_current_placeholder"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/outlet_template_pick"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/templateSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_outline" />

            <CheckBox
                android:id="@+id/syncModules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:checked="true"
                android:fontFamily="@font/poppinsregular"
                android:text="@string/outlet_template_sync_modules"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/noOutlets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppinsregular"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/outlet_template_no_outlets"
                android:textColor="@color/colorTextSecondary"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/saveBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_button_primary"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:text="@string/outlet_template_save"
        android:textColor="@color/white"
        android:textSize="15sp" />
</LinearLayout>
