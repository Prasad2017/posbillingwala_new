<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    tools:context=".Fragment.ManageCustomerProductPortions">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        app:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/backToHome"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_sm"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/manage_portions"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:padding="@dimen/spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/productInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsmedium"
                        android:padding="@dimen/spacing_lg"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_subtitle" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/radius_lg"
                    app:cardElevation="@dimen/card_elevation"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_lg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsbold"
                            android:letterSpacing="0.06"
                            android:text="@string/portion_master_detail"
                            android:textAllCaps="true"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_caption" />

                        <com.posbillingwala.owner.Extra.SearchableDropdownView
                            android:id="@+id/portionMasterSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            app:sdd_dialog_title="Portion Master"
                            app:sdd_hint="Select Portion Master" />

                        <TextView
                            android:id="@+id/managePortionMasterLink"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/poppinsmedium"
                            android:text="Manage Portion Master"
                            android:textColor="@color/colorPrimary"
                            android:textSize="@dimen/text_caption" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/radius_sm"
                            app:boxStrokeColor="@color/colorBorder">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/portionPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppinsregular"
                                android:hint="Portion Price"
                                android:inputType="numberDecimal"
                                android:singleLine="true"
                                android:textColor="@color/colorTextPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                            app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                            app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                            app:boxCornerRadiusTopStart="@dimen/radius_sm"
                            app:boxStrokeColor="@color/colorBorder">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/portionSortOrder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppinsregular"
                                android:hint="Sort Order"
                                android:inputType="number"
                                android:singleLine="true"
                                android:text="0"
                                android:textColor="@color/colorTextPrimary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/addPortion"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="@dimen/spacing_xl"
                            android:background="@drawable/bg_button_primary"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/add_portion"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_button" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/portionListCardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsbold"
                        android:letterSpacing="0.06"
                        android:text="@string/manage_portions"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_caption" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:cardBackgroundColor="@color/colorSurface"
                        app:cardCornerRadius="@dimen/radius_lg"
                        app:cardElevation="@dimen/card_elevation"
                        app:strokeColor="@color/colorBorder"
                        app:strokeWidth="1dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/portionRecyclerview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingTop="@dimen/spacing_xs"
                            android:paddingBottom="@dimen/spacing_xs" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/noDataFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl"
            android:visibility="gone">

            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:fontFamily="@font/poppinsbold"
                android:gravity="center"
                android:text="P"
                android:textColor="@color/colorPrimary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="@font/poppinsmedium"
                android:gravity="center"
                android:text="No portions found.\nAdd a portion for this product."
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
