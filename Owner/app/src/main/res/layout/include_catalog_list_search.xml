<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/colorBorder"
    app:strokeWidth="1dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/listSearchLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_md"
        android:textColorHint="@color/colorTextHint"
        app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
        app:boxCornerRadiusBottomStart="@dimen/radius_sm"
        app:boxCornerRadiusTopEnd="@dimen/radius_sm"
        app:boxCornerRadiusTopStart="@dimen/radius_sm"
        app:boxStrokeColor="@color/colorBorder"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/search"
        app:startIconTint="@color/colorTextHint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/listSearchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppinsregular"
            android:hint="@string/ui_search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_md"
            android:singleLine="true"
            android:textColor="@color/colorTextPrimary"
            android:textSize="@dimen/text_body" />
    </com.google.android.material.textfield.TextInputLayout>
</com.google.android.material.card.MaterialCardView>
