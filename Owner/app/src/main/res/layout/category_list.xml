<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md">

        <TextView
            android:id="@+id/srNo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/categoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:fontFamily="@font/poppinsmedium"
            android:textColor="@color/colorTextPrimary"
            android:textSize="@dimen/text_subtitle" />

        <TextView
            android:id="@+id/categorySubcategories"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:background="@drawable/bg_button_outline"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Sub"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/categoryEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/colorPrimary" />

        <ImageView
            android:id="@+id/categoryRemove"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/statusExpired" />
    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorBorder" />
</LinearLayout>
