<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:alpha="0.35"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/closeNewUserSheet"
            android:fontFamily="@font/poppinsbold"
            android:text="New User Licence Detail"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/closeNewUserSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:contentDescription="@string/app_name"
            android:padding="4dp"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/app_logo" />

    <TextView
        android:id="@+id/supportMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/poppinslight"
        android:justificationMode="inter_word"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/contactUser"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_sheet_btn_primary"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:text="Call Support Team"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="15sp" />
</LinearLayout>
