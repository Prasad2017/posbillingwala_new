<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_pos_report_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Sales shortcuts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.34"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/ui_sales_and_reports"
                android:textAllCaps="true"
                android:textColor="@color/colorTextHint"
                android:textSize="11sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowSalesDashboard"
                        layout="@layout/item_grouped_menu_row" />

                    <include
                        android:id="@+id/rowSalesOverview"
                        layout="@layout/item_grouped_menu_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:text="@string/ui_data_management"
                android:textAllCaps="true"
                android:textColor="@color/colorTextHint"
                android:textSize="11sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <include
                    android:id="@+id/rowDeleteAllInvoices"
                    layout="@layout/item_grouped_menu_row" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Operational reports -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.66"
            android:layout_marginStart="8dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/ui_operational_reports"
                    android:textAllCaps="true"
                    android:textColor="@color/colorTextHint"
                    android:textSize="11sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/rowInvoiceReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowSaleReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowTableReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowTakeAwayReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowPaymentReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowDiscountReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowRefundReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowProductReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowComboReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowExpenseReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowMessMemberReport"
                            layout="@layout/item_grouped_menu_row" />

                        <include
                            android:id="@+id/rowMessReport"
                            layout="@layout/item_grouped_menu_row" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</RelativeLayout>
