<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_pos_report_toolbar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Billing + store -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/setting_section_billing"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextHint"
                        android:textSize="11sp" />

                    <com.pos_billingwala.Extra.PosCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"

>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/invoiceDetailsLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/reportLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/masterDataLayout"
                                layout="@layout/item_grouped_menu_row" />
                        </LinearLayout>
                    </com.pos_billingwala.Extra.PosCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.08"
                        android:text="@string/setting_section_store"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextHint"
                        android:textSize="11sp" />

                    <com.pos_billingwala.Extra.PosCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"

>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/shopDetailLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/businessHoursLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/printerDetailLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/inventoryManagementLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/expenseManagementLayout"
                                layout="@layout/item_grouped_menu_row" />
                        </LinearLayout>
                    </com.pos_billingwala.Extra.PosCardView>
                </LinearLayout>

                <!-- Cloud + account -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/setting_section_cloud"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextHint"
                        android:textSize="11sp" />

                    <com.pos_billingwala.Extra.PosCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"

>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/supportLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/aboutLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/fetchDataLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/updateAppLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/synchronizeLayout"
                                layout="@layout/item_grouped_menu_row" />
                        </LinearLayout>
                    </com.pos_billingwala.Extra.PosCardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:letterSpacing="0.08"
                        android:text="@string/setting_section_account"
                        android:textAllCaps="true"
                        android:textColor="@color/colorTextHint"
                        android:textSize="11sp" />

                    <com.pos_billingwala.Extra.PosCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"

>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/appPinLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/languageLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/rateUsLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/shareAppLayout"
                                layout="@layout/item_grouped_menu_row" />

                            <include
                                android:id="@+id/logoutLayout"
                                layout="@layout/item_grouped_menu_row" />
                        </LinearLayout>
                    </com.pos_billingwala.Extra.PosCardView>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="120dp"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/app_logo" />

            <TextView
                android:id="@+id/appVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppinsregular"
                android:textColor="@color/colorTextHint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/appDevelopedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:autoLink="email"
                android:fontFamily="@font/poppinsmedium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/developed_by_webus_labs_llp"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp" />

            <com.google.android.gms.ads.AdView
                android:id="@+id/ad_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                ads:adSize="SMART_BANNER"
                ads:adUnitId="ca-app-pub-2325627373654257/3294693541" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
