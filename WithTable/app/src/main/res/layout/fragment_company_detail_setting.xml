<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Fragment.CompanyDetailSetting">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        app:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/backToSetting"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_sm"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppinsmedium"
                android:text="@string/setting_shop_details"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_md">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/shop_section_branding" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/spacing_md">

                        <ImageView
                            android:id="@+id/profilePhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_input"
                            android:clickable="true"
                            android:contentDescription="@string/shop_section_branding"
                            android:focusable="true"
                            android:padding="@dimen/spacing_md"
                            android:scaleType="fitCenter"
                            android:src="@drawable/your_logo_here" />

                        <ImageView
                            android:id="@+id/addProfile"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="@dimen/spacing_sm"
                            android:background="@drawable/bg_fab_primary"
                            android:contentDescription="@string/shop_section_branding"
                            android:padding="8dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/shop_logo_hint"
                        android:textColor="@color/colorTextHint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/shop_section_identity" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shopName1Layout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shopName1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_shop_name_1"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shopName2Layout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shopName2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_shop_name_2"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addressLine1Layout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/addressLine1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_address_line_1"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addressLine2Layout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/addressLine2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_address_line_2"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addressLine3Layout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/addressLine3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_address_line_3"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/shop_section_contact" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneNo1Layout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneNo1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_phone_no_1"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="10"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/phoneNo2Layout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phoneNo2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_phone_no_2"
                            android:imeOptions="actionNext"
                            android:inputType="number"
                            android:maxLength="10"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/cashierNameLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/cashierName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_cashier_name"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/shop_section_operations" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/ui_invoice_currency"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/input_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/spacing_sm">

                        <com.jaredrummler.materialspinner.MaterialSpinner
                            android:id="@+id/currencySpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body"
                            app:ms_hint="Select Currency" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tableSectionLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:background="@color/colorBorder" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/tableSwitch"
                            style="@style/PosSwitchRow"
                            android:checked="true"
                            android:text="@string/ui_use_table"
                            android:textOff="Off"
                            android:textOn="On" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/noOfTableLayout"
                            style="@style/PosFormTextInput"
                            android:layout_marginTop="@dimen/spacing_sm">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/noOfTable"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppinsregular"
                                android:hint="@string/ui_no_of_table"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:paddingStart="@dimen/spacing_lg"
                                android:paddingEnd="@dimen/spacing_md"
                                android:singleLine="true"
                                android:text="0"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/shop_section_tax" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/countryNameLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/countryName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_country_name"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/stateNameLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/stateName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_state_name"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:background="@color/colorBorder" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/gstSwitch"
                        style="@style/PosSwitchRow"
                        android:checked="true"
                        android:text="@string/ui_gst"
                        android:textOff="Off"
                        android:textOn="On" />

                    <LinearLayout
                        android:id="@+id/shopGSTLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/gstNumberLayout"
                            style="@style/PosFormTextInput"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:visibility="visible">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/gstNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
                                android:fontFamily="@font/poppinsregular"
                                android:hint="@string/ui_gst_number"
                                android:imeOptions="actionNext"
                                android:inputType="textCapCharacters"
                                android:paddingStart="@dimen/spacing_lg"
                                android:paddingEnd="@dimen/spacing_md"
                                android:singleLine="true"
                                android:textAllCaps="true"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_md"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/shopCGSTLayout"
                                style="@style/PosFormTextInput"
                                android:layout_width="0dp"
                                android:layout_marginEnd="@dimen/spacing_sm"
                                android:layout_weight="1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/shopCGST"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/poppinsregular"
                                    android:hint="@string/ui_shop_cgst"
                                    android:imeOptions="actionNext"
                                    android:inputType="numberDecimal"
                                    android:paddingStart="@dimen/spacing_lg"
                                    android:paddingEnd="@dimen/spacing_md"
                                    android:singleLine="true"
                                    android:text="0"
                                    android:textColor="@color/colorTextPrimary"
                                    android:textSize="@dimen/text_body" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/shopSGSTLayout"
                                style="@style/PosFormTextInput"
                                android:layout_width="0dp"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:layout_weight="1">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/shopSGST"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:enabled="false"
                                    android:fontFamily="@font/poppinsregular"
                                    android:hint="@string/ui_shop_sgst"
                                    android:imeOptions="actionDone"
                                    android:inputType="numberDecimal"
                                    android:paddingStart="@dimen/spacing_lg"
                                    android:paddingEnd="@dimen/spacing_md"
                                    android:singleLine="true"
                                    android:text="0"
                                    android:textColor="@color/colorTextPrimary"
                                    android:textSize="@dimen/text_body" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/panNumberLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/panNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_pan_number"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textAllCaps="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/shopFssaiLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/shopFssai"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_shop_fssai_number"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textAllCaps="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/shop_section_payment" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginTop="@dimen/spacing_md">

                        <ImageView
                            android:id="@+id/paymentQRPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_input"
                            android:clickable="true"
                            android:contentDescription="@string/shop_section_payment"
                            android:focusable="true"
                            android:padding="@dimen/spacing_md"
                            android:scaleType="fitCenter"
                            android:src="@drawable/make_your_qr" />

                        <ImageView
                            android:id="@+id/addPaymentQR"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="@dimen/spacing_sm"
                            android:background="@drawable/bg_fab_primary"
                            android:contentDescription="@string/shop_section_payment"
                            android:padding="8dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/shop_qr_hint"
                        android:textColor="@color/colorTextHint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/saveDetails"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:text="@string/ui_save_details"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button" />
    </LinearLayout>
</LinearLayout>
