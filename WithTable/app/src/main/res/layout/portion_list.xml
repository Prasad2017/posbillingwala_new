<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm">

        <TextView
            android:id="@+id/srNo"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/portionName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppinsmedium"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/portionPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppinsregular"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <ImageView
            android:id="@+id/portionEdit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/colorPrimary" />

        <ImageView
            android:id="@+id/portionRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/statusExpired" />
    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorBorder" />
</LinearLayout>
