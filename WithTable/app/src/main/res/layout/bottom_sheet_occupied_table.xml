<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/occupiedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/occupiedAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppinsregular"
        android:gravity="center"
        android:textColor="@color/grey_60"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/occupiedActionAdd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/add_items_table_button_view"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:text="Add Items to Existing Bill"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/occupiedActionView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/add_items_table_button_view"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:text="View Bill"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/occupiedActionSettle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/continue_items_table_button_view"
        android:fontFamily="@font/poppinsmedium"
        android:gravity="center"
        android:text="Settle Bill"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/occupiedActionCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppinsregular"
        android:gravity="center"
        android:text="@android:string/cancel"
        android:textColor="@color/grey_60"
        android:textSize="14sp" />
</LinearLayout>
