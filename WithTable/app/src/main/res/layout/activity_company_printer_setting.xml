<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Activity.CompanyPrinterSetting">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        app:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/backToSetting"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_sm"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/invoicePreview"
                android:layout_toEndOf="@id/backToSetting"
                android:ellipsize="end"
                android:fontFamily="@font/poppinsmedium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/setting_printer_details"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title" />

            <TextView
                android:id="@+id/invoicePreview"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacing_md"
                android:background="@drawable/bg_toolbar_chip"
                android:fontFamily="@font/poppinsmedium"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:text="@string/ui_invoice_preview"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_caption" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_md">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_printers" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/ui_invoice_printer_name"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_input"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/input_height"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/spacing_xs"
                        android:paddingEnd="@dimen/spacing_sm">

                        <com.jaredrummler.materialspinner.MaterialSpinner
                            android:id="@+id/printerSpinner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppinsregular"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body"
                            app:ms_hint="Select Printer" />

                        <TextView
                            android:id="@+id/connectPrinter"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_button_primary"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:paddingStart="@dimen/spacing_md"
                            android:paddingEnd="@dimen/spacing_md"
                            android:text="@string/ui_connect"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/KOTPrinterLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:text="@string/ui_kot_print_printer_name"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_body" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/input_height"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/spacing_xs"
                            android:paddingEnd="@dimen/spacing_sm">

                            <com.jaredrummler.materialspinner.MaterialSpinner
                                android:id="@+id/KOTPrinterSpinner"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppinsregular"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body"
                                app:ms_hint="Select Printer" />

                            <TextView
                                android:id="@+id/connectKOTPrinter"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_button_primary"
                                android:fontFamily="@font/poppinsmedium"
                                android:gravity="center"
                                android:paddingStart="@dimen/spacing_md"
                                android:paddingEnd="@dimen/spacing_md"
                                android:text="@string/ui_connect"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_connection" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/ui_connection_type"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_body" />

                    <com.jaredrummler.materialspinner.MaterialSpinner
                        android:id="@+id/connectionTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_input"
                        android:fontFamily="@font/poppinsregular"
                        android:minHeight="@dimen/input_height"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_body"
                        app:ms_hint="@string/ui_connection_type" />

                    <LinearLayout
                        android:id="@+id/wifiPrinterLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/PosFormTextInput">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/printerIpAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppinsregular"
                                android:hint="@string/ui_printer_ip"
                                android:imeOptions="actionNext"
                                android:inputType="text"
                                android:paddingStart="@dimen/spacing_lg"
                                android:paddingEnd="@dimen/spacing_md"
                                android:singleLine="true"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/PosFormTextInput"
                            android:layout_marginTop="@dimen/spacing_md">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/printerPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789"
                                android:fontFamily="@font/poppinsregular"
                                android:hint="@string/ui_printer_port"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:paddingStart="@dimen/spacing_lg"
                                android:paddingEnd="@dimen/spacing_md"
                                android:singleLine="true"
                                android:text="9100"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/usbPrinterLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:text="@string/ui_usb_printer"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_body" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/input_height"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/spacing_xs"
                            android:paddingEnd="@dimen/spacing_sm">

                            <com.jaredrummler.materialspinner.MaterialSpinner
                                android:id="@+id/usbPrinterSpinner"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppinsregular"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body"
                                app:ms_hint="@string/ui_usb_printer" />

                            <TextView
                                android:id="@+id/refreshUsbPrinter"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_button_primary"
                                android:fontFamily="@font/poppinsmedium"
                                android:gravity="center"
                                android:paddingStart="@dimen/spacing_md"
                                android:paddingEnd="@dimen/spacing_md"
                                android:text="@string/ui_refresh_usb"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/autoCutSwitch"
                        style="@style/PosSwitchRow"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:checked="true"
                        android:text="@string/ui_auto_cut"
                        android:textOff="Off"
                        android:textOn="On" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/cashDrawerSwitch"
                        style="@style/PosSwitchRow"
                        android:checked="false"
                        android:text="@string/ui_cash_drawer"
                        android:textOff="Off"
                        android:textOn="On" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/ui_open_drawer_for"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_body" />

                    <com.jaredrummler.materialspinner.MaterialSpinner
                        android:id="@+id/drawerOpenModeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="@drawable/bg_input"
                        android:fontFamily="@font/poppinsregular"
                        android:minHeight="@dimen/input_height"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_body"
                        app:ms_hint="@string/ui_open_drawer_for" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/testCutterButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_primary"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/ui_test_cutter"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/testCashDrawerButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_primary"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/ui_test_cash_drawer"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_invoice" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/invoicePrefixLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/invoicePrefix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ./-"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_sales_invoice_prefix"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textAllCaps="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/printerFeedLinesLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/printerFeedLines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_print_feed_lines"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/KotPrinterFeedLinesLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/KotPrinterFeedLines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_kot_print_feed_lines"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:paddingBottom="@dimen/spacing_sm">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_bill" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/logoSwitch"
                        style="@style/PosSwitchRow"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:checked="false"
                        android:text="@string/ui_use_logo_on_bill"
                        android:textOff="Off"
                        android:textOn="On" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/paymentSwitch"
                        style="@style/PosSwitchRow"
                        android:checked="false"
                        android:text="@string/ui_use_payment_qr_on_bill"
                        android:textOff="Off"
                        android:textOn="On" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/customerSwitch"
                        style="@style/PosSwitchRow"
                        android:checked="false"
                        android:text="@string/ui_use_customer_details_on_bill"
                        android:textOff="Off"
                        android:textOn="On" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/productQuantityUpdate"
                        style="@style/PosSwitchRow"
                        android:checked="false"
                        android:text="@string/ui_product_quantity_update"
                        android:textOff="Off"
                        android:textOn="On" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/duplicateBillSwitch"
                        style="@style/PosSwitchRow"
                        android:checked="false"
                        android:text="@string/ui_duplicate_bill_copy"
                        android:textOff="Off"
                        android:textOn="On" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/ui_duplicate_bill_copy_hint"
                        android:textColor="@color/colorTextHint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/card_elevation"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_terms" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/invoiceTitleLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/invoiceTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_sales_invoice_title"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/invoiceTermsConditionLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/invoiceTermsCondition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ. "
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_invoice_terms_amp_conditions"
                            android:inputType="textCapWords|textMultiLine"
                            android:minLines="3"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/saveSetting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:text="@string/ui_save_setting"
            android:textColor="@color/white"
            android:textSize="@dimen/text_button" />
    </LinearLayout>
</LinearLayout>
