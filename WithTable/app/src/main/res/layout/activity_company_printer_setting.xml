<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".Activity.CompanyPrinterSetting">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorPrimary"
        app:elevation="4dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/backToSetting"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_sm"
                android:contentDescription="@null"
                android:padding="@dimen/spacing_sm"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_toStartOf="@id/invoicePreview"
                android:layout_toEndOf="@id/backToSetting"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppinsbold"
                    android:text="@string/setting_printer_details"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:id="@+id/toolbarSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppinsregular"
                    android:text="@string/ui_printer_details_subtitle"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/invoicePreview"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/spacing_md"
                android:background="@drawable/bg_toolbar_chip"
                android:fontFamily="@font/poppinsmedium"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:text="@string/ui_invoice_preview"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_caption" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="@dimen/spacing_lg">

        <LinearLayout
            android:id="@+id/printerFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_md">

            <com.pos_billingwala.Extra.PosCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"

>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_printers" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/ui_invoice_printer_name"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.pos_billingwala.Extra.SearchableDropdownView
                            android:id="@+id/printerDropdown"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:sdd_dialog_title="@string/ui_invoice_printer_name"
                            app:sdd_hint="@string/ui_invoice_printer_name" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:gravity="end"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/invoiceConnectedStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_status_dot_green" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/poppinsmedium"
                                    android:text="@string/ui_printer_connected"
                                    android:textColor="@color/statusActive"
                                    android:textSize="@dimen/text_caption" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/connectPrinter"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:background="@drawable/bg_button_primary"
                                android:fontFamily="@font/poppinsmedium"
                                android:gravity="center"
                                android:minWidth="96dp"
                                android:paddingStart="@dimen/spacing_md"
                                android:paddingEnd="@dimen/spacing_md"
                                android:text="@string/ui_connect"
                                android:textColor="@color/white"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/disconnectPrinter"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="@dimen/spacing_xs"
                                android:background="@drawable/bg_button_disconnect"
                                android:fontFamily="@font/poppinsmedium"
                                android:gravity="center"
                                android:minWidth="96dp"
                                android:paddingStart="@dimen/spacing_md"
                                android:paddingEnd="@dimen/spacing_md"
                                android:text="@string/ui_disconnect"
                                android:textColor="@color/red_900"
                                android:textSize="@dimen/text_caption"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/KOTPrinterLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:text="@string/ui_kot_print_printer_name"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_body" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.pos_billingwala.Extra.SearchableDropdownView
                                android:id="@+id/kotPrinterDropdown"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:sdd_dialog_title="@string/ui_kot_print_printer_name"
                                app:sdd_hint="@string/ui_kot_print_printer_name" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_sm"
                                android:gravity="end"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/kotConnectedStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:visibility="gone"
                                    tools:visibility="visible">

                                    <View
                                        android:layout_width="8dp"
                                        android:layout_height="8dp"
                                        android:background="@drawable/bg_status_dot_green" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="@font/poppinsmedium"
                                        android:text="@string/ui_printer_connected"
                                        android:textColor="@color/statusActive"
                                        android:textSize="@dimen/text_caption" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/connectKOTPrinter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:background="@drawable/bg_button_primary"
                                    android:fontFamily="@font/poppinsmedium"
                                    android:gravity="center"
                                    android:minWidth="96dp"
                                    android:paddingStart="@dimen/spacing_md"
                                    android:paddingEnd="@dimen/spacing_md"
                                    android:text="@string/ui_connect"
                                    android:textColor="@color/white"
                                    android:textSize="@dimen/text_caption" />

                                <TextView
                                    android:id="@+id/disconnectKOTPrinter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="36dp"
                                    android:layout_marginTop="@dimen/spacing_xs"
                                    android:background="@drawable/bg_button_disconnect"
                                    android:fontFamily="@font/poppinsmedium"
                                    android:gravity="center"
                                    android:minWidth="96dp"
                                    android:paddingStart="@dimen/spacing_md"
                                    android:paddingEnd="@dimen/spacing_md"
                                    android:text="@string/ui_disconnect"
                                    android:textColor="@color/red_900"
                                    android:textSize="@dimen/text_caption"
                                    android:visibility="gone"
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.pos_billingwala.Extra.PosCardView>

            <com.pos_billingwala.Extra.PosCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/radius_lg"

>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_invoice" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/invoicePrefixLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/invoicePrefix"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ./-"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_sales_invoice_prefix"
                            android:imeOptions="actionNext"
                            android:inputType="textCapCharacters"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textAllCaps="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/printerFeedLinesLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/printerFeedLines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_print_feed_lines"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/KotPrinterFeedLinesLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/KotPrinterFeedLines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="0123456789"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_kot_print_feed_lines"
                            android:imeOptions="actionNext"
                            android:inputType="numberDecimal"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.pos_billingwala.Extra.PosCardView>

            <com.pos_billingwala.Extra.PosCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/radius_lg"

>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/spacing_lg"
                    android:paddingTop="@dimen/spacing_lg"
                    android:paddingEnd="@dimen/spacing_lg"
                    android:paddingBottom="@dimen/spacing_sm">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_bill" />

                    <com.pos_billingwala.Extra.PosSwitchRowView
                        android:id="@+id/logoSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        app:psr_label="@string/ui_use_logo_on_bill" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <com.pos_billingwala.Extra.PosSwitchRowView
                        android:id="@+id/paymentSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:psr_label="@string/ui_use_payment_qr_on_bill" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <com.pos_billingwala.Extra.PosSwitchRowView
                        android:id="@+id/customerSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:psr_label="@string/ui_use_customer_details_on_bill" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <com.pos_billingwala.Extra.PosSwitchRowView
                        android:id="@+id/productQuantityUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:psr_label="@string/ui_product_quantity_update" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorBorder" />

                    <com.pos_billingwala.Extra.PosSwitchRowView
                        android:id="@+id/duplicateBillSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:psr_label="@string/ui_duplicate_bill_copy" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:fontFamily="@font/poppinsregular"
                        android:text="@string/ui_duplicate_bill_copy_hint"
                        android:textColor="@color/colorTextHint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </com.pos_billingwala.Extra.PosCardView>

            <com.pos_billingwala.Extra.PosCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                app:cardCornerRadius="@dimen/radius_lg"

>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/PosSectionLabel"
                        android:text="@string/printer_section_terms" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/invoiceTitleLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/invoiceTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_sales_invoice_title"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:singleLine="true"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/invoiceTermsConditionLayout"
                        style="@style/PosFormTextInput"
                        android:layout_marginTop="@dimen/spacing_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/invoiceTermsCondition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ. "
                            android:fontFamily="@font/poppinsregular"
                            android:hint="@string/ui_invoice_terms_amp_conditions"
                            android:inputType="textCapWords|textMultiLine"
                            android:minLines="3"
                            android:paddingStart="@dimen/spacing_lg"
                            android:paddingEnd="@dimen/spacing_md"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_body" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.pos_billingwala.Extra.PosCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        android:padding="@dimen/spacing_lg">

        <include
            android:id="@+id/saveSetting"
            layout="@layout/include_action_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height" />
    </LinearLayout>
</LinearLayout>
