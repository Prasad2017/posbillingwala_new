<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".Fragment.Home">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/spacing_xl">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_lg">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/userPhotoContainer"
                    android:layout_width="52dp"
                    android:layout_height="52dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/userPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/app_logo"
                        app:civ_border_color="@color/colorBorder"
                        app:civ_border_width="1dp" />

                    <View
                        android:id="@+id/networkStatusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/status_dot"
                        android:contentDescription="@string/status_online" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/shopName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsbold"
                        android:text="@string/good_morning"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_heading" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/homeDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsregular"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_caption"
                        tools:text="Fri, 28 Aug 2026  01:48:00 PM" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/homeBusinessHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppinsmedium"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone"
                        tools:text="Shop Open  9:00 AM – 10:00 PM"
                        tools:visibility="visible" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/userSettingIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_circle"
                    android:contentDescription="@string/user_setting_title"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/colorTextPrimary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppinsregular"
                android:text="@string/home_whats_happening"
                android:textColor="@color/colorTextSecondary"
                android:textSize="@dimen/text_body" />

            <!-- Sales -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:fontFamily="@font/poppinsbold"
                android:text="@string/home_section_sales"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/totalSalesCardView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kpi_card_green"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_kpi_icon_green"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_report_sales"
                                app:tint="@color/statusActive" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/hideShowTotalSale"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_show"
                                app:tint="@color/colorTextSecondary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/totalSale"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsbold"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppinsmedium"
                            android:lineSpacingExtra="0dp"
                            android:text="@string/home_total_sales"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/todaySalesCardView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kpi_card_blue"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_kpi_icon_blue"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_report_dashboard"
                                app:tint="@color/colorPrimary" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:id="@+id/hideShowTodaySale"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_show"
                                app:tint="@color/colorTextSecondary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/todaySaleAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsbold"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:text="0"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/poppinsmedium"
                            android:lineSpacingExtra="0dp"
                            android:text="@string/home_today_sales"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Catalog -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:fontFamily="@font/poppinsbold"
                android:text="@string/home_section_catalog"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:id="@+id/subcategoryCardView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kpi_card_blue"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="@dimen/spacing_md"
                        android:paddingEnd="8dp"
                        android:paddingBottom="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_kpi_icon_blue"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_category"
                            app:tint="@color/colorPrimary" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/totalSubcategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/poppinsbold"
                            android:text="0"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/home_total_subcategory"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/productCardView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kpi_card_green"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="@dimen/spacing_md"
                        android:paddingEnd="8dp"
                        android:paddingBottom="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_kpi_icon_green"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_report_product"
                            app:tint="@color/statusActive" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/totalProduct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/poppinsbold"
                            android:text="0"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/home_total_products"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/comboCardView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_kpi_card_orange"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="@dimen/spacing_md"
                        android:paddingEnd="8dp"
                        android:paddingBottom="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_kpi_icon_orange"
                            android:contentDescription="@null"
                            android:padding="6dp"
                            android:src="@drawable/ic_report_combo"
                            app:tint="@color/statusTrial" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/totalCombo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:fontFamily="@font/poppinsbold"
                            android:text="0"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/home_total_combos"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Start Billing -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:fontFamily="@font/poppinsbold"
                android:text="@string/home_section_billing"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_title" />

            <LinearLayout
                android:id="@+id/posBillingRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fastBilling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="96dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/colorPrimaryLight"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_quick_action_blue"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_receipt"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/fast_billing"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tableBilling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="96dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/colorPrimaryLight"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_quick_action_green"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_table"
                            app:tint="@color/statusActive" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/dine_in"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/posBillingRow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/takeAwayBilling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="96dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/colorPrimaryLight"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_quick_action_orange"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_takeaway"
                            app:tint="@color/statusTrial" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/take_away"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/messBilling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="96dp"
                    app:cardBackgroundColor="@color/colorSurface"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/colorPrimaryLight"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_quick_action_purple"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_report_mess"
                            app:tint="@color/deepPurple" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/mess"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/fetchDataLayout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_outline"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cloud_download"
                        app:tint="@color/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppinsmedium"
                        android:text="@string/home_fetch_data"
                        android:textColor="@color/colorPrimary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/synchronizeLayout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cloud_upload"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/poppinsmedium"
                        android:text="@string/home_synchronize"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>

            <!-- Low inventory (hidden until populated) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/inventoryCardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppinsbold"
                        android:text="@string/home_low_inventory"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_subtitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/srNo"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/ui_sr_no_2"
                            android:textColor="@color/colorTextHint"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/productName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/ui_product_2"
                            android:textColor="@color/colorTextHint"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/inventoryQty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/ui_inventory_qty"
                            android:textColor="@color/colorTextHint"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/afterSaleInventoryQty"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppinsmedium"
                            android:gravity="center"
                            android:text="@string/ui_sale_inventory_qty"
                            android:textColor="@color/colorTextHint"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/colorBorder" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.gms.ads.AdView
                android:id="@+id/ad_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:layout_marginBottom="@dimen/spacing_sm"
                ads:adSize="SMART_BANNER"
                ads:adUnitId="ca-app-pub-2325627373654257/6815283571" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
