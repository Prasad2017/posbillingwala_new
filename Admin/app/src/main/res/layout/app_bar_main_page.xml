<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_app_bar_primary"
    android:minHeight="?attr/actionBarSize"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:id="@+id/navButtonSlot"
        android:layout_width="@dimen/touch_min"
        android:layout_height="@dimen/touch_min"
        android:layout_centerVertical="true">

        <ImageView
            android:id="@+id/menu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Menu"
            android:padding="12dp"
            android:src="@drawable/ic_nav_drawer"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="@color/white" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/titleBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/toolbarActions"
        android:layout_toEndOf="@+id/navButtonSlot"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppinsbold"
            android:maxLines="1"
            android:text="Dashboard"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolbarActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/notifications"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Notifications"
                android:padding="8dp"
                android:src="@drawable/ic_notifications"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/notificationBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_expired"
                android:fontFamily="@font/poppinsmedium"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/logout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/logout"
            android:padding="8dp"
            android:src="@drawable/ic_logout"
            android:visibility="gone"
            app:tint="@color/white" />
    </LinearLayout>
</RelativeLayout>
