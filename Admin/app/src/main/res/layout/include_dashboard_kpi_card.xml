<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kpiCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/kpiCardInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_kpi_card_blue"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/kpiIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_kpi_icon_blue"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_nav_customers"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/statValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/poppinsbold"
                android:gravity="end"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/colorTextPrimary"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="start"
            android:lineSpacingExtra="0dp"
            android:maxLines="2"
            android:minLines="2"
            android:text="Label"
            android:textColor="@color/colorTextPrimary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/statTrend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="start"
            android:maxLines="1"
            android:text="↑ 0% vs last month"
            android:textColor="@color/statusActive"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
