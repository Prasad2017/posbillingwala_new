<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="32dp">
        <TextView android:id="@+id/dateChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_month_chip" android:fontFamily="@font/poppinsmedium" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp" android:text="Today" android:textColor="@color/colorPrimary" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <include android:id="@+id/kpi1" layout="@layout/include_report_kpi_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" />
            <include android:id="@+id/kpi2" layout="@layout/include_report_kpi_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <include android:id="@+id/kpi3" layout="@layout/include_report_kpi_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" />
            <include android:id="@+id/kpi4" layout="@layout/include_report_kpi_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeColor="@color/colorBorder" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/poppinsmedium" android:text="Sales Trend" android:textColor="@color/colorTextPrimary" android:textSize="15sp" />
                <com.github.mikephil.charting.charts.LineChart android:id="@+id/chartTrend" android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/colorSurface" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeColor="@color/colorBorder" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/poppinsmedium" android:text="Recent Bills" android:textColor="@color/colorTextPrimary" android:textSize="15sp" />
                    <TextView android:id="@+id/viewAllBills" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/poppinsmedium" android:text="View All" android:textColor="@color/colorPrimary" android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/billsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
