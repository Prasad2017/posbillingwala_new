<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/colorBorder"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/spacing_sm">

        <ImageView
            android:id="@+id/perfIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_kpi_icon_blue"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_nav_sales"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/statLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:ellipsize="end"
            android:fontFamily="@font/poppinsregular"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:text="Label"
            android:textColor="@color/colorTextSecondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/statValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppinsbold"
            android:gravity="center"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/colorTextPrimary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/statTrend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/poppinsmedium"
            android:gravity="center"
            android:maxLines="1"
            android:text="↑ 0%"
            android:textColor="@color/statusActive"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
